# Optional local-only private character image for desktop development.
# Put the real path in .env.local. Do not commit proprietary character assets.
VITE_AMADEUS_PRIVATE_CHARACTER_IMAGE=

# Optional TTS endpoint selection.
# Defaults to py-gpt-sovits on http://127.0.0.1:48162.
# Set AMADEUS_TTS_ENGINE=genie-onnx to default to http://127.0.0.1:48163.
AMADEUS_TTS_ENGINE=py-gpt-sovits
AMADEUS_TTS_ENDPOINT=

# Optional local-only Shinku style context.
# rag-summary reads local extracted lines but only sends non-verbatim summaries and source ids to Hermes.
# Use off to disable style retrieval while keeping the 悠马/悠馬 naming rule.
AMADEUS_SHINKU_STYLE_MODE=rag-summary
AMADEUS_SHINKU_STYLE_ROOT=/home/shinku/data/plan/soul-desktop-pet/style_pack/shinku-speech-style
AMADEUS_SHINKU_LINES_PATH=/home/shinku/data/plan/soul-desktop-pet/shinku_lines/shinku_lines.tsv
